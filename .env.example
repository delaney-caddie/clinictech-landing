# ClinicTech — Environment Variables
# Copy to .env.local and fill in your keys

# Admin panel password
ADMIN_PASSWORD=

# Fiber AI (contact enrichment — owner name, email, phone)
FIBER_API_KEY=

# Google Maps (clinic discovery)
GOOGLE_MAPS_API_KEY=

# Firecrawl (scraper) — get a key at firecrawl.dev
FIRECRAWL_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ClinicTech domain (for preview URLs)
CLINICTECH_DOMAIN=clinictech.io

# Email outreach
SENDER_NAME=Danika
SENDER_TITLE=Co-founder, ClinicTech
SENDER_EMAIL=danika@clinictech.io
CALENDAR_LINK=https://calendar.app.google/WCKTy12it4D4kMkH7

# Composio (Gmail OAuth — preferred, no app password needed)
COMPOSIO_API_KEY=

# Gmail SMTP fallback (if Composio not set up)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
